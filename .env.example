# Copy to .env and fill in. Every value here is optional — the app runs without
# any of them, using a local mock for auth and relative URLs for link previews.

# Absolute base URL of the deployed site, with no trailing slash. Used to build
# the og:image, og:url, and canonical tags, which link preview scrapers cannot
# resolve from relative paths.
VITE_SITE_URL=https://campusquest.example.com

# Supabase project credentials. Set both to switch signup and login from the
# local mock to real Supabase auth. The anon key is safe to expose in a client
# bundle; never put a service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
